PI, 2026)"],"notes":["Deux formes relevées dans des sources différentes ; elles peuvent refléter lexèmes, notation ou variété distincte. À ne pas fusionner sans validation."],"themes":["T6"]},{"concept":"souris / mouse","forms":["Tòlò"],"sources":["Resulam/Bitjaa Kody 2020"],"notes":[],"themes":["T6"]},{"concept":"chat / cat","forms":["Síŋgî"],"sources":["Resulam/Bitjaa Kody 2020"],"notes":[],"themes":["T6"]},{"concept":"gorille / gorilla","forms":["pàgí"],"sources":["Edu-Kultur, alphabet ɓàsàá"],"notes":["La source signale une réalisation orale avec consonne différente."],"themes":["T6"]},{"concept":"médecin / travailleur clinique","forms":["dòktà","dokta","dokte"],"sources":["Cameroon Basaa course / ERIC OCR"],"notes":["Emprunt adapté, avec variations de transcription dans les éditions/OCR."],"themes":["T7"]},{"concept":"voiture / car","forms":["lìtóà","litoa"],"sources":["Edu-Kultur, alphabet ɓàsàá","Cameroon Basaa course (ancienne transcription/OCR)"],"notes":["Même emprunt avec conventions graphiques différentes."],"themes":["T8"]},{"concept":"route / road","forms":["nloo","Nloo"],"sources":["Cameroon Basaa course (ancienne transcription/OCR)"],"notes":["Forme issue de la transcription du manuel ; tons à vérifier."],"themes":["T8"]},{"concept":"aller / go (forme verbale observée)","forms":["ke","kɛ́ / formes apparentées à confirmer"],"sources":["Cameroon Basaa course","formes modernes à contrôler"],"notes":["Le manuel ancien fournit plusieurs phrases avec « ke » ; la normalisation moderne doit être vérifiée."],"themes":["T8"]},{"concept":"allons / let’s go","forms":["Dí kɛ́nɛ̄k!"],"sources":["Resulam/Bitjaa Kody 2020"],"notes":[],"themes":["T8"]},{"concept":"voiture dans une phrase ancienne","forms":["ni litoa"],"sources":["Cameroon Basaa course"],"notes":["« en voiture / by car » dans la source ancienne."],"themes":["T8"]}]}